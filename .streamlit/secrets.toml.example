# Copy into Streamlit Cloud: App → Settings → Secrets. Never commit real values to GitHub.
# TOML rule: plain "key = value" lines must come BEFORE any [section].

demo_roles = true                 # one-click "Enter" buttons for each role on the landing page
google_default_role = "Viewer"    # role for Google accounts not listed in [google_roles]

# ---- Passcode accounts. Roles: Administrator, Contracts Manager, Contracts Staff, Security Reviewer, Viewer
[[users]]
name = "Avery Collins"
role = "Administrator"
passcode = "change-me-1"

[[users]]
name = "Morgan Lee"
role = "Contracts Manager"
passcode = "change-me-2"

[[users]]
name = "Jordan Reyes"
role = "Contracts Staff"
passcode = "change-me-3"

[[users]]
name = "Sam Patel"
role = "Security Reviewer"
passcode = "change-me-4"

[[users]]
name = "Riley Brooks"
role = "Viewer"
passcode = "change-me-5"

# ---- Live inbox (Gmail with an App Password)
[mail]
user = "yourname@gmail.com"
password = "abcd efgh ijkl mnop"          # Google Account → Security → App passwords
only_to = "yourname+rfpdemo@gmail.com"    # ONLY emails sent to this address are read. Others are never touched.
from_name = "Contracts Administration (DataPoch demo)"

# ---- Optional: Sign in with Google
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "any-long-random-text-at-least-32-characters"

[auth.google]
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Which Google account gets which role (lowercase emails)
[google_roles]
"you@gmail.com" = "Administrator"
"colleague@gmail.com" = "Contracts Manager"

# ---- Optional: AI check (free key from console.groq.com)
[ai]
api_key = "gsk_..."
model = "llama-3.1-8b-instant"
